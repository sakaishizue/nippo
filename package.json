{
  "name": "nippo",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @nippo/api --filter @nippo/web dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "generate": "pnpm --filter @nippo/api db:generate",
    "typecheck": "pnpm generate && tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "pnpm generate && vitest run",
    "test:watch": "pnpm generate && vitest",
    "test:coverage": "pnpm generate && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
