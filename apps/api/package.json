{
  "name": "@nippo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "reminder": "tsx --env-file-if-exists=.env src/jobs/run-reminders.ts"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "2.5.2",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@nippo/shared": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "dotenv": "18.0.9",
    "esbuild": "0.28.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
