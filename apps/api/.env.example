# このファイルを .env にコピーして使う(.env は Git に含めない)
NODE_ENV=development
PORT=8080

# アプリが使う接続先。本番とステージングは Neon の接続プール用のURL
DATABASE_URL=postgres://nippo:nippo@localhost:5432/nippo
# マイグレーションが使う接続先。本番とステージングは Neon の直接接続のURL。ローカルは DATABASE_URL と同じでよい
DIRECT_URL=postgres://nippo:nippo@localhost:5432/nippo

# Docker がなく prisma dev を使う場合は 1 にする。prisma dev は同時に複数の接続から問い合わせると、
# 「bind message supplies ... parameters」などのエラーになるため。Docker の PostgreSQL や本番では設定しない
# DATABASE_POOL_MAX=1
