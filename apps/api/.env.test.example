# このファイルを .env.test にコピーして使う(.env.test は Git に含めない)
# データベースを使うAPIテスト(*.db.test.ts)の接続先。テストのたびに全データを消すので、開発用とは別のデータベースにする
# Docker の場合: docker compose で起動した PostgreSQL に nippo_test データベースを作って指定する
# Docker がない場合: pnpm --filter @nippo/api exec prisma dev --name nippo-test --detach で起動し、表示されたURLを指定する
TEST_DATABASE_URL=postgres://nippo:nippo@localhost:5432/nippo_test
